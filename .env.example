# PostgreSQL / TimescaleDB
POSTGRES_USER=tek
POSTGRES_PASSWORD=tek_secret
POSTGRES_DB=tek_sensor
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+asyncpg://tek:tek_secret@timescaledb:5432/tek_sensor
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin
VIEWER_LOGIN=viewer
VIEWER_PASSWORD=viewer
# LAN-IP хоста — для сниппета ESP и Flutter Web (prod: https://<LAN-IP>)
API_PUBLIC_BASE_URL=https://192.168.0.181
# URL для ESP (HTTP, порт 80). Пусто = автоматически http:// из API_PUBLIC_BASE_URL
DEVICE_INGEST_BASE_URL=http://192.168.0.181

# CORS (prod: comma-separated origins; пусто = * для dev)
CORS_ORIGINS=

# Логирование (JSON в prod)
LOG_LEVEL=INFO
JSON_LOGS=true

# Rate limiting ingest
INGEST_RATE_LIMIT=120/minute
INGEST_MAX_BATCH_SIZE=100

# MQTT (опционально; docker compose --profile mqtt)
MQTT_ENABLED=false
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Gunicorn workers (1 для корректного WebSocket без Redis)
WEB_CONCURRENCY=1

# Подтверждение email/телефона в настройках профиля
# Режим: log (коды только в логах, без отправки), production (реальная отправка), test (pytest)
VERIFICATION_DELIVERY_MODE=log
VERIFICATION_SMTP_HOST=smtp.gmail.com
VERIFICATION_SMTP_PORT=587
VERIFICATION_SMTP_USER=<email>
# Пароль приложения Gmail (16 символов): https://myaccount.google.com/apppasswords
# Обычный пароль аккаунта для SMTP не подходит.
VERIFICATION_SMTP_PASSWORD=
# SMS.ru API ID: https://sms.ru/?panel=api
VERIFICATION_SMS_API_ID=
VERIFICATION_SMS_FROM=<phone>
VERIFICATION_CODE_TTL_MINUTES=10
