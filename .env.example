# PostgreSQL / TimescaleDB
POSTGRES_USER=tek
POSTGRES_PASSWORD=<strong-postgres-password>
POSTGRES_DB=tek_sensor
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432

# Backend
APP_ENV=production
DATABASE_URL=postgresql+asyncpg://tek:<strong-postgres-password>@timescaledb:5432/tek_sensor
JWT_SECRET=<random-32+-char-secret>
JWT_EXPIRE_MINUTES=720
ADMIN_LOGIN=admin
ADMIN_PASSWORD=<strong-admin-password>
VIEWER_LOGIN=viewer
VIEWER_PASSWORD=<strong-viewer-password>
ALLOW_PUBLIC_REGISTRATION=false

# Replace 192.168.1.100 with your host LAN IP (see README: ipconfig / ifconfig)
API_PUBLIC_BASE_URL=https://192.168.1.100
# URL for ESP ingest (HTTP, port 80). Empty = derive http:// from API_PUBLIC_BASE_URL
DEVICE_INGEST_BASE_URL=http://192.168.1.100

# CORS (prod: required; comma-separated origins)
CORS_ORIGINS=https://192.168.1.100
# Логирование (JSON в prod)
LOG_LEVEL=INFO
JSON_LOGS=true

# Rate limiting
INGEST_RATE_LIMIT=120/minute
AUTH_LOGIN_RATE_LIMIT=10/minute
AUTH_REGISTER_RATE_LIMIT=5/minute
AUTH_VERIFY_RATE_LIMIT=10/minute
INGEST_MAX_BATCH_SIZE=100

# MQTT (опционально; docker compose --profile mqtt)
MQTT_ENABLED=false
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Gunicorn workers (1 для корректного WebSocket без Redis)
WEB_CONCURRENCY=1

# Подтверждение email/телефона — только dev (ALLOW_PUBLIC_REGISTRATION=true)
VERIFICATION_DELIVERY_MODE=log
VERIFICATION_SMTP_HOST=smtp.gmail.com
VERIFICATION_SMTP_PORT=587
VERIFICATION_SMTP_USER=
VERIFICATION_SMTP_PASSWORD=
VERIFICATION_SMS_API_ID=
VERIFICATION_SMS_FROM=
VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=5
