# PostgreSQL / TimescaleDB
POSTGRES_USER=tek
POSTGRES_PASSWORD=tek_secret
POSTGRES_DB=tek_sensor
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+asyncpg://tek:tek_secret@timescaledb:5432/tek_sensor
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin
VIEWER_LOGIN=viewer
VIEWER_PASSWORD=viewer
# LAN-IP хоста с backend — для сниппета ESP при создании датчика (не localhost)
API_PUBLIC_BASE_URL=http://192.168.0.181:8000

# Подтверждение email/телефона в настройках профиля
# Режим: log (коды только в логах, без отправки), production (реальная отправка), test (pytest)
VERIFICATION_DELIVERY_MODE=log
VERIFICATION_SMTP_HOST=smtp.gmail.com
VERIFICATION_SMTP_PORT=587
VERIFICATION_SMTP_USER=<email>
# Пароль приложения Gmail (16 символов): https://myaccount.google.com/apppasswords
# Обычный пароль аккаунта для SMTP не подходит.
VERIFICATION_SMTP_PASSWORD=
# SMS.ru API ID: https://sms.ru/?panel=api
VERIFICATION_SMS_API_ID=
VERIFICATION_SMS_FROM=<phone>
VERIFICATION_CODE_TTL_MINUTES=10
